# Atlas + Hono quickstart — copy to .env and fill in your instance's values.
# Load it with `tsx --env-file=.env src/server.ts` (Node 20+).

# Local JWT verification (used by @atlasauth/hono). No secret key needed.
ATLAS_JWKS_URL=https://atlasauth.net/.well-known/jwks.json
ATLAS_ISSUER=https://atlasauth.net

# Optional — used for azp / authorized-parties checks.
ATLAS_PUBLISHABLE_KEY=pk_test_xxx

PORT=3000
